    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nlet totalRevenue = 0;\nlet totalProfit = 0;\nlet totalQuantity = 0;\nconst byRegion = {};\nconst byProduct = {};\n\nfor (const item of items) {\n  const revenue = Number(item.json.Revenue) || 0;\n  const profit = Number(item.json.Profit) || 0;\n  const quantity = Number(item.json.Quantity) || 0;\n  const region = item.json.Region || 'Unknown';\n  const product = item.json.Product || 'Unknown';\n\n  totalRevenue += revenue;\n  totalProfit += profit;\n  totalQuantity += quantity;\n\n  byRegion[region] = (byRegion[region] || 0) + revenue;\n  byProduct[product] = (byProduct[product] || 0) + revenue;\n}\n\nreturn [{\n  json: {\n    totalRevenue,\n    totalProfit,\n    totalQuantity,\n    profitMargin: ((totalProfit / totalRevenue) * 100).toFixed(2) + '%',\n    revenueByRegion: byRegion,\n    revenueByProduct: byProduct\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        176
      ],
      "id": "efed887e-51cd-4485-9bad-2383b60ceaa7",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=\nRevenue and Profits:Generate a professional Weekly KPI Sales Report as a complete HTML email with this exact data:\n\nTotal Revenue: {{$json.totalRevenue}}\nTotal Profit: {{$json.totalProfit}}\nTotal Quantity Sold: {{$json.totalQuantity}}\nProfit Margin: {{$json.profitMargin}}\nAverage Order Value: {{Math.round($json.totalRevenue / 5)}}\n\nRevenue by Region:\n- Lahore: {{$json.revenueByRegion.Lahore}}\n- Karachi: {{$json.revenueByRegion.Karachi}}\n- Islamabad: {{$json.revenueByRegion.Islamabad}}\n\nRevenue by Product:\n- Wireless Mouse: {{$json.revenueByProduct['Wireless Mouse']}}\n- Keyboard: {{$json.revenueByProduct.Keyboard}}\n- Monitor: {{$json.revenueByProduct.Monitor}}\n\nDesign Requirements:\n1. Dark navy blue header with \"Weekly KPI Report\" title and current date\n2. Executive Summary paragraph explaining the numbers\n3. KPI Cards section with 4 colorful cards:\n   - Orange card: Total Revenue\n   - Green card: Total Profit\n   - Purple card: Profit Margin\n   - Red card: Avg Order Value\n4. Revenue by Region table with styled rows\n5. Revenue by Product table with styled rows\n6. Top performing region and product highlighted\n7. AI insights paragraph at the bottom\n8. All amounts in Rs (Pakistani Rupees)\n9. Professional fonts and clean layout\n10. Return ONLY the HTML code, nothing else",
        "batching": {}
      },
