    {
      "parameters": {
        "jsCode": "// n8n Code Node — Extract Instagram structured data from Apify search results\n\nconst results = $input.all();\nconst structured = [];\n\n// Convert \"1.8K+ followers\" → 1800\nfunction parseFollowers(str) {\n  if (!str) return null;\n  const clean = str.toLowerCase().replace(/followers|\\+|,|\\s/g, '').trim();\n  if (clean.includes('k')) return Math.round(parseFloat(clean) * 1000);\n  if (clean.includes('m')) return Math.round(parseFloat(clean) * 1000000);\n  return parseInt(clean) || null;\n}\n\nfor (const item of results) {\n  const data = Array.isArray(item.json) ? item.json : [item.json];\n\n  for (const entry of data) {\n    const organicResults = Array.isArray(entry.organicResults)\n      ? entry.organicResults\n      : [];\n\n    for (const result of organicResults) {\n      if (\n        result.url &&\n        result.url.includes(\"instagram.com\") &&\n        result.channelName\n      ) {\n        structured.push({\n          json: {\n            name: result.channelName || null,\n            instagram_url: result.url || null,\n            displayed_url: result.displayedUrl || null,\n            followers: parseFollowers(result.followersAmount),  // ← CHANGED\n            description: result.description || null,\n            services: result.emphasizedKeywords\n              ? result.emphasizedKeywords.join(\", \")\n              : null,\n            position: result.position ?? null,\n            type: result.type || null,\n          },\n        });\n      }\n    }\n  }\n}\n\nreturn structured;"
      },
